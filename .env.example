# ───────────────────────────── Server ─────────────────────────────
PORT=8080
NODE_ENV=production

# Secret used to derive CSRF tokens (REQUIRED in production)
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Session lifetime in hours (default: 12)
SESSION_HOURS=12

# Set to true when serving over HTTPS so cookies get the Secure flag
COOKIE_SECURE=false

# ───────────────────────────── Database ───────────────────────────
# SQLite database file location (defaults to <DATA_DIR>/attendance.db)
DATA_DIR=./data
DB_FILE=

# ───────────────────── Notification providers ─────────────────────
# Real outbound delivery is done via configurable HTTPS webhooks.
# Point these at your provider of choice (an API gateway you control,
# Zapier/Make webhook, Twilio Studio flow, a mail relay, ...).
# The request is:  POST <url>  { channel, to, message, student, meta }
# with an optional "Authorization: Bearer <*_WEBHOOK_AUTH>" header.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_AUTH=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_AUTH=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_AUTH=


# ────── Native providers (recommended) — HTTPS-only, no extra packages ──────
# Pick ONE native provider per channel; it wins over the generic webhook.
# Secrets NEVER go in the UI or DB — keep them here.

# SMS via Twilio:
SMS_PROVIDER=twilio          # set to 'twilio' to activate
WHATSAPP_PROVIDER=twilio     # 'twilio' or 'meta' — WhatsApp only
# Twilio (shared by SMS + WhatsApp):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                 # SMS sender, E.164 e.g. +14155551234
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio WA sandbox / approved sender

# WhatsApp via Meta Cloud API (alternative to Twilio):
META_WA_PHONE_NUMBER_ID=
META_WA_TOKEN=
META_WA_TEMPLATE_NAME=       # approved utility template with ONE body variable {{1}}
META_WA_LANG=en_US           # leave template empty to send free text (24h window only)

# Email via SendGrid HTTPS API:
EMAIL_PROVIDER=sendgrid      # set to 'sendgrid' to activate
SENDGRID_API_KEY=
SENDGRID_FROM=alerts@your-institution.edu
SENDGRID_FROM_NAME=Attendance Office

# Phone numbers without a country code are interpreted as mobiles from:
NOTIFY_COUNTRY_CODE=91

# Development/demo provider. When true, messages are NOT delivered to
# real parents; they are written to <DATA_DIR>/notifications.log and
# the stored provider_response clearly carries {"simulated": true}.
SIMULATE_NOTIFICATIONS=true

# ───────────────────────────── Uploads ────────────────────────────
UPLOAD_MAX_MB=5
